# engram — mẫu biến môi trường. KHÔNG đặt secret thật vào file này.
APP_ENV=development
LOG_LEVEL=info

# Một origin duy nhất cho dev: Next ở :3000 proxy /api sang Go ở :8080.
APP_ORIGIN=http://localhost:3000
HTTP_ADDR=127.0.0.1:8080
SHUTDOWN_TIMEOUT=15s
# Host dev only: Next proxies /api to the locally running Go API.
API_UPSTREAM=http://127.0.0.1:8080
# Optional full-Compose override; leave unset to use the service name below.
# COMPOSE_API_UPSTREAM=http://api:8080

DATABASE_URL=postgres://engram:engram@localhost:5432/engram?sslmode=disable

# noop = không có embedding thật; semantic KHÔNG khả dụng.
# Đổi sang tei và điền TEI_URL khi bật profile semantic của compose.
EMBEDDING_PROVIDER=noop
TEI_URL=

# P02 auth — để trống. Development tự sinh ephemeral lúc boot (session mất khi restart).
# Local bền: openssl rand -base64 32  (năm giá trị KHÁC NHAU)
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Hoặc: node scripts/gen-dev-secrets.mjs
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_REAUTH_SECRET=
AUTH_IP_PEPPER=
AUTH_EMAIL_PEPPER=

AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_GOOGLE_REAUTH_ENABLED=false
# Local/e2e only. Production/staging reject this flag. Not Google/GitHub production.
AUTH_FAKE_OAUTH=false
AUTH_AUDIT_RETENTION_DAYS=90

# Để trống cả cặp = ẩn nút provider. Một nửa cặp bị reject lúc boot.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Thư mục trong workspace (không web-serve, không commit). Production không dùng sink.
AUTH_MAIL_SINK_DIR=.data/mail-sink

# Production: CIDR peer được tin X-Forwarded-For, mặc định trống.
# Development mặc định tin loopback + dải private nếu để trống.
AUTH_TRUSTED_PROXY_CIDRS=
