# engram — mẫu biến môi trường. KHÔNG đặt secret thật vào file này.
APP_ENV=development
LOG_LEVEL=info

# Một origin duy nhất cho dev: Next ở :3000 proxy /api sang Go ở :8080.
APP_ORIGIN=http://localhost:3000
HTTP_ADDR=127.0.0.1:8080
SHUTDOWN_TIMEOUT=15s
# Host dev only: Next proxies /api to the locally running Go API.
API_UPSTREAM=http://127.0.0.1:8080
# Optional full-Compose override; leave unset to use the service name below.
# COMPOSE_API_UPSTREAM=http://api:8080

DATABASE_URL=postgres://engram:engram@localhost:5432/engram?sslmode=disable

# P05 search & embedding (plan mục 2.13, SPEC §4.4).
# noop = không có embedding thật; semantic KHÔNG khả dụng mặc định.
# Profile `semantic` của compose (service `tei`) là opt-in (amd64 only; mặc định TEI_MODEL_ID=BAAI/bge-m3).
SEARCH_SEMANTIC_ENABLED=true
EMBEDDING_PROVIDER=noop
TEI_URL=
# Profile `semantic-fake` (CI) requires non-empty TEI_INPUT_PREFIX_QUERY='query: ' (and TEI_INPUT_PREFIX_DOCUMENT='passage: ') so fakeembed can classify query vs document requests; calibration accepts any qp/dp.
TEI_INPUT_PREFIX_QUERY=
TEI_INPUT_PREFIX_DOCUMENT=
# Compose-only override cho service `tei` (không nạp vào config.go):
# TEI_MODEL_ID=BAAI/bge-m3

# OpenAI-compatible provider (ADR 0004). KHÔNG đặt API key thật vào file này.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openrouter/qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_QUERY_INSTRUCTION=Given a short search query, retrieve matching item names or tags
# Để trống EMBEDDING_QUERY_TIMEOUT -> 300ms (tei) hoặc 4s (openai_compat).
EMBEDDING_QUERY_TIMEOUT=
EMBEDDING_DOCUMENT_TIMEOUT=30s

# Production path block (user-dec-021, ADR 0004 — host ARM64 `bro` dùng openai_compat):
# Lưu ý: dùng provider ngoài => features.semantic_external=true, cần công bố quyền riêng tư
# (disclosure) và mỗi user có công tắc opt-in/opt-out riêng trong Settings (#timkiem).
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDING_BASE_URL=https://<provider-host>/v1
# EMBEDDING_API_KEY=   # set only in the VPS env, never commit
# EMBEDDING_MODEL=openrouter/qwen/qwen3-embedding-8b
# EMBEDDING_DIMENSIONS=1024

# Shadow embedding client cho generation cutover không gián đoạn (§6.6, ADR 0007).
# Để trống EMBEDDING_SHADOW_PROVIDER = tắt shadow.
EMBEDDING_SHADOW_PROVIDER=
EMBEDDING_SHADOW_BASE_URL=
EMBEDDING_SHADOW_API_KEY=
EMBEDDING_SHADOW_MODEL=openrouter/qwen/qwen3-embedding-8b
EMBEDDING_SHADOW_DIMENSIONS=1024
EMBEDDING_SHADOW_QUERY_INSTRUCTION=Given a short search query, retrieve matching item names or tags
EMBEDDING_SHADOW_QUERY_TIMEOUT=
EMBEDDING_SHADOW_DOCUMENT_TIMEOUT=30s
EMBEDDING_SHADOW_INPUT_PREFIX_QUERY=
EMBEDDING_SHADOW_INPUT_PREFIX_DOCUMENT=

# P05 vector search knobs & worker observability (§6.3, §6.4, §6.6).
SEARCH_EXACT_MAX_VECTORS=5000
SEARCH_EXACT_FALLBACK_MAX_VECTORS=20000
SEARCH_HNSW_EF_SEARCH=64
SEARCH_HNSW_MAX_SCAN_TUPLES=20000
SEARCH_HNSW_ITERATIVE_SCAN=relaxed_order
# Để trống -> bật SET LOCAL plan_cache_mode = force_custom_plan cho nhánh lexical; đặt off để tắt.
SEARCH_LEXICAL_FORCE_CUSTOM_PLAN=
SEARCH_VECTOR_BRANCH_TIMEOUT=80ms
SEARCH_VECTOR_FALLBACK_MIN_BUDGET=30ms
SEARCH_ROLLBACK_WINDOW=168h
WORKER_METRICS_ADDR=
# Chỉ dùng cho test (CI job e2e-search-semantic đặt 5s; bị từ chối khi APP_ENV=production):
EMBEDDING_BOOTSTRAP_FLIP_INTERVAL=

# P02 auth — để trống. Development tự sinh ephemeral lúc boot (session mất khi restart).
# Local bền: openssl rand -base64 32  (năm giá trị KHÁC NHAU)
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Hoặc: node scripts/gen-dev-secrets.mjs
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_REAUTH_SECRET=
AUTH_IP_PEPPER=
AUTH_EMAIL_PEPPER=

AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_GOOGLE_REAUTH_ENABLED=false
# Local/e2e only. Production/staging reject this flag. Not Google/GitHub production.
AUTH_FAKE_OAUTH=false
AUTH_AUDIT_RETENTION_DAYS=90

# Để trống cả cặp = ẩn nút provider. Một nửa cặp bị reject lúc boot.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Thư mục trong workspace (không web-serve, không commit). Production không dùng sink.
AUTH_MAIL_SINK_DIR=.data/mail-sink

# Production: CIDR peer được tin X-Forwarded-For, mặc định trống.
# Development mặc định tin loopback + dải private nếu để trống.
AUTH_TRUSTED_PROXY_CIDRS=

# P03 vault / WebAuthn RP — để trống ở development sẽ tự suy từ APP_ORIGIN.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=
