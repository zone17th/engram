    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-query": "^5.102.8",
    "canonicalize": "5.1.0",
    "clsx": "^2.1.1",
    "libsodium-wrappers-sumo": "0.8.4",
    "next": "15.5.25",
    "next-intl": "^4.14.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
