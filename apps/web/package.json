{
  "name": "@engram/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "matrix:list": "node scripts/matrix-list.mjs",
    "verify:crypto-vectors": "vitest run lib/crypto/vectors.test.ts lib/crypto/recovery.test.ts",
    "gen:crypto-vectors": "node -e \"process.env.GEN_CRYPTO_VECTORS='1';process.exit(require('node:child_process').spawnSync(process.execPath,['./node_modules/vitest/vitest.mjs','run','lib/crypto/vectors.test.ts','lib/crypto/recovery.test.ts'],{stdio:'inherit'}).status??1)\""
  },
  "dependencies": {
    "@engram/shared-types": "workspace:*",
