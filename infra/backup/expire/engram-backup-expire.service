[Unit]
Description=engram 8-day backup retention sweep (P06 Task 22, PROD-STEP-RETENTION, C09)
# Deliberately no Requires/After on engram-backup.service or engram-pitr-base.service:
# the sweep runs every hour even when a backup failed (retention contract (b)).

[Service]
Type=oneshot
Environment=EXPIRE_BACKUP_ROOT=/home/ubuntu/backups/engram
# Set at PROD-STEP-4 (WAL archive owned by the container's postgres); empty before PITR exists.
EnvironmentFile=-/home/ubuntu/engram-ops/expire/expire.env
ExecStart=/home/ubuntu/engram-ops/expire/engram-backup-expire.sh
