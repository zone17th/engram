{
  "name": "engram",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "dev:stack": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:worker": "node scripts/dev.mjs worker",
    "dev:web": "node scripts/dev.mjs web",
    "migrate": "node scripts/dev.mjs migrate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "stack:up": "node scripts/dev.mjs compose-up",
    "stack:down": "node scripts/dev.mjs compose-down",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:auth": "node scripts/e2e.mjs --verify=both"
  }
}
